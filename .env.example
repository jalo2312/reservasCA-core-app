# Conexión a PostgreSQL (debe coincidir con docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/reservas_core?schema=public"

# Puerto del servidor HTTP
PORT=3001

# Seguridad JWT
JWT_SECRET="cambia_este_secreto_en_produccion"
JWT_EXPIRES_IN="1h"

# Orígenes permitidos por CORS (lista separada por comas)
CLIENT_ORIGIN="http://localhost:5173,http://localhost:8080"
